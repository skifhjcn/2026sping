</div>

<script>
/* =========================================================
   whatieattoday — social edition
   - multi-user simulation (account switch)
   - friend system: search / request / accept / reject
   - exchange-diary guestbook: canvas drawing + text on friends' meals
   - visibility filtering (public / friends / private)
   - feed + notifications
   In-memory store (resets on reload), seeded with demo data.
   ========================================================= */

const DAYS = ['일','월','화','수','목','금','토'];
const MEALS = ['아침','점심','저녁'];
const AVATAR_COLORS = { me:'#a89070', mina:'#c4756a', jun:'#7a9b76', soa:'#6f8bab' };

/* ---------- date helpers ---------- */
function fmt(d){ return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`; }
function dayOffsetKey(offset){ const d=new Date(); d.setDate(d.getDate()+offset); return fmt(d); }
function isToday(d){ return fmt(d)===fmt(new Date()); }

/* ---------- USERS ---------- */
const users = {
  me:   { id:'me',   name:'채민',   code:'GRP-CHAE', avatarText:'채' },
  mina: { id:'mina', name:'미나',   code:'GRP-MINA', avatarText:'미' },
  jun:  { id:'jun',  name:'준호',   code:'GRP-JUN',  avatarText:'준' },
  soa:  { id:'soa',  name:'소아',   code:'GRP-SOA',  avatarText:'소' },
};
let currentUser = 'me';

/* ---------- FRIEND GRAPH ---------- (symmetric on accept) */
const friendships = {           // userId -> Set of friend ids
  me:   new Set(['mina','jun']),
  mina: new Set(['me','jun','soa']),
  jun:  new Set(['me','mina']),
  soa:  new Set(['mina']),
};
/* pending requests: { from, to } */
let friendRequests = [
  { from:'soa', to:'me' },      // soa already wants to be channel's friend (demo)
];

/* ---------- DIARIES ---------- diary[userId][dateKey-meal] = entry */
const diaries = { me:{}, mina:{}, jun:{}, soa:{} };

/* entry shape: { menu, memo, tags:[], photo, visibility, notes:[ {by, byName, text, draw(dataURL), ts} ] } */
function blankEntry(){ return { menu:'', memo:'', tags:[], photo:null, visibility:'friends', notes:[] }; }

/* ---------- SEED DEMO DATA ---------- */
function seed(){
  // channel(me)'s own records
  diaries.me[`${dayOffsetKey(0)}-아침`] = { menu:'아보카도 토스트', memo:'간단하게 시작한 하루', tags:['건강했어','간단했어'], photo:null, visibility:'friends', notes:[] };
  diaries.me[`${dayOffsetKey(-1)}-저녁`] = { menu:'마라탕', memo:'시험기간 스트레스엔 역시 마라탕 🌶️', tags:['맛있었어','과식했어'], photo:null, visibility:'public',
    notes:[ { by:'mina', byName:'미나', text:'헐 나도 어제 마라탕 먹음 ㅋㅋㅋ 통했다', draw:null, ts:Date.now()-3600e3 } ] };

  // mina's records
  diaries.mina[`${dayOffsetKey(0)}-점심`] = { menu:'연어 포케', memo:'학식 질려서 포케집 감', tags:['건강했어','특별했어'], photo:null, visibility:'friends', notes:[] };
  diaries.mina[`${dayOffsetKey(0)}-아침`] = { menu:'그릭요거트', memo:'다이어트 3일차...', tags:['건강했어'], photo:null, visibility:'public', notes:[] };
  diaries.mina[`${dayOffsetKey(-1)}-저녁`] = { menu:'엽기떡볶이', memo:'오늘은 치팅데이!', tags:['맛있었어','특별했어'], photo:null, visibility:'friends',
    notes:[ { by:'jun', byName:'준호', text:'나도 끼워줘ㅠ', draw:null, ts:Date.now()-7200e3 } ] };

  // jun's records
  diaries.jun[`${dayOffsetKey(0)}-점심`] = { menu:'김치찌개 백반', memo:'역시 한식이 최고', tags:['맛있었어'], photo:null, visibility:'friends', notes:[] };
  diaries.jun[`${dayOffsetKey(-2)}-저녁`] = { menu:'수제버거', memo:'홍대 신상 버거집 발견', tags:['맛있었어','특별했어'], photo:null, visibility:'public', notes:[] };

  // soa's records (soa is NOT yet channel's friend → should be filtered out of feed)
  diaries.soa[`${dayOffsetKey(0)}-점심`] = { menu:'파스타', memo:'친구공개라 채민이는 못 봄', tags:['맛있었어'], photo:null, visibility:'friends', notes:[] };
}
seed();

/* ---------- NOTIFICATIONS ---------- notif[userId] = [ {id,text,ts,read} ] */
const notifs = { me:[], mina:[], jun:[], soa:[] };
function pushNotif(userId, text){
  notifs[userId].unshift({ id:Date.now()+Math.random(), text, ts:Date.now(), read:false });
}
pushNotif('me','<b>미나</b>님이 회원님의 <b>마라탕</b> 식탁에 한마디를 남겼어요 💌');
pushNotif('me','<b>소아</b>님이 친구 요청을 보냈어요 👋');

/* ===========================================================
   NAVIGATION
   =========================================================== */
let weekOffset = 0;
let activeTab = 'home';

function switchTab(tab){
  activeTab = tab;
  ['home','feed','friends','notif'].forEach(t=>{
    document.getElementById('tab-'+t).style.display = (t===tab)?'block':'none';
    document.getElementById('nav-'+t).classList.toggle('active', t===tab);
  });
  if(tab==='feed') renderFeed();
  if(tab==='friends') renderFriends();
  if(tab==='notif'){ renderNotifs(); markAllNotifsRead(); }
  window.scrollTo(0,0);
}

/* ===========================================================
   ACCOUNT SWITCHER (multi-user simulation)
   =========================================================== */
function openAcctSheet(){
  const box = document.getElementById('acct-opts');
  box.innerHTML='';
  Object.values(users).forEach(u=>{
    const b=document.createElement('button');
    b.className='acct-opt'+(u.id===currentUser?' current':'');
    b.onclick=()=>switchAccount(u.id);
    b.innerHTML=`<span class="avatar" style="background:${AVATAR_COLORS[u.id]}">${u.avatarText}</span>
      <span style="text-align:left;"><span class="ao-name">${u.name}</span><br><span class="ao-code">${u.code}</span></span>`;
    box.appendChild(b);
  });
  document.getElementById('acct-sheet').style.display='block';
}
function closeAcctSheet(){ document.getElementById('acct-sheet').style.display='none'; }
function switchAccount(id){
  currentUser=id; closeAcctSheet();
  weekOffset=0; switchTab('home'); refreshAll();
  toast(`${users[id].name}님으로 전환했어요`);
}

/* ===========================================================
   HEADER / BADGES
   =========================================================== */
function refreshAll(){
  const u=users[currentUser];
  document.getElementById('me-name').textContent=u.name;
  document.getElementById('me-code').textContent=u.code;
  const av=document.getElementById('me-avatar');
  av.textContent=u.avatarText; av.style.background=AVATAR_COLORS[currentUser];
  document.getElementById('my-code-hint').textContent=`내 코드: ${u.code} · 친구에게 공유해보세요`;
  renderGrid();
  updateBadges();
}
function updateBadges(){
  const unread = notifs[currentUser].filter(n=>!n.read).length;
  ['notif-badge','notif-tab-badge'].forEach(id=>{
    const el=document.getElementById(id);
    el.style.display = unread>0?'flex':'none'; el.textContent=unread;
  });
  const reqCount = friendRequests.filter(r=>r.to===currentUser).length;
  const fb=document.getElementById('friends-badge');
  fb.style.display = reqCount>0?'flex':'none'; fb.textContent=reqCount;
}

/* ===========================================================
   HOME GRID (own diary)
   =========================================================== */
function getWeekDates(offset){
  const today=new Date(); const day=today.getDay();
  const monday=new Date(today);
  monday.setDate(today.getDate()-(day===0?6:day-1)+offset*7);
  return Array.from({length:7},(_,i)=>{ const d=new Date(monday); d.setDate(monday.getDate()+i); return d; });
}
function changeWeek(dir){ weekOffset+=dir; renderGrid(); }

function renderGrid(){
  const dates=getWeekDates(weekOffset);
  document.getElementById('week-label').textContent=
    `${dates[0].getMonth()+1}/${dates[0].getDate()} — ${dates[6].getMonth()+1}/${dates[6].getDate()}`;
  const grid=document.getElementById('days-grid'); grid.innerHTML='';
  const dayOrder=[1,2,3,4,5,6,0]; const dayLabels=['월','화','수','목','금','토','일'];
  const diary=diaries[currentUser];

  dayOrder.forEach((di,idx)=>{
    const date=dates[di];
    const col=document.createElement('div'); col.className='day-col';
    const lbl=document.createElement('div');
    lbl.className='day-label'+(isToday(date)?' today':'');
    lbl.textContent=dayLabels[idx]; col.appendChild(lbl);

    MEALS.forEach(meal=>{
      const key=`${fmt(date)}-${meal}`;
      const entry=diary[key];
      const btn=document.createElement('button');
      btn.className='meal-thumb'+(entry&&entry.photo?' has-photo':(entry&&entry.draw?' has-draw':''));
      btn.onclick=()=>openDetail(date,meal,key);

      if(entry&&entry.photo){
        const img=document.createElement('img'); img.src=entry.photo; btn.appendChild(img);
      } else if(entry&&entry.menu){
        const wrap=document.createElement('div');
        wrap.style.cssText='width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#fdf6e8,#f5edd8);border-radius:14px;font-size:13px;color:#8b6f4e;text-align:center;padding:2px;line-height:1.1;';
        wrap.textContent=entry.menu.length>6?entry.menu.slice(0,6):entry.menu;
        btn.appendChild(wrap);
      } else {
        const def=document.createElement('div'); def.className='default-icon';
        def.innerHTML=`<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#a89070" stroke-width="1.3" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>`;
        btn.appendChild(def);
      }
      // friend-note marker
      if(entry&&entry.notes&&entry.notes.length){
        const dot=document.createElement('span'); dot.className='friend-dot'; btn.appendChild(dot);
      }
      const tl=document.createElement('span'); tl.className='meal-time-label'; tl.textContent=meal;
      btn.appendChild(tl); col.appendChild(btn);
    });
    grid.appendChild(col);
  });
}

/* ===========================================================
   DETAIL (edit my own meal)
   =========================================================== */
let currentKey=null, currentVis='friends';

function openDetail(date,meal,key){
  currentKey=key;
  const entry=diaries[currentUser][key]||blankEntry();
  document.getElementById('detail-title').textContent=`${date.getMonth()+1}월 ${date.getDate()}일 ${DAYS[date.getDay()]}요일`;
  document.getElementById('detail-subtitle').textContent=meal+ (entry.notes&&entry.notes.length?` · 친구 한마디 ${entry.notes.length}개 💌`:'');

  const ph=document.getElementById('detail-photo');
  const placeholder=document.getElementById('photo-placeholder');
  const overlayBtn=document.getElementById('photo-overlay-btn');
  if(entry.photo){
    ph.src=entry.photo; ph.style.display='block'; placeholder.style.display='none'; overlayBtn.style.display='flex';
  } else {
    ph.style.display='none'; ph.src=''; placeholder.style.display='flex'; overlayBtn.style.display='none';
  }
  document.getElementById('menu-input').value=entry.menu||'';
  document.getElementById('memo-box').value=entry.memo||'';
  document.querySelectorAll('#tag-chips .tag-chip').forEach(c=>
    c.classList.toggle('selected',(entry.tags||[]).includes(c.textContent)));
  currentVis=entry.visibility||'friends';
  document.querySelectorAll('#vis-row .vis-opt').forEach(o=>o.classList.toggle('selected',o.dataset.vis===currentVis));

  document.getElementById('detail-view').style.display='block';
  document.getElementById('detail-view').scrollTop=0;
}
function closeDetail(){ document.getElementById('detail-view').style.display='none'; renderGrid(); }
function triggerPhoto(){ document.getElementById('photo-input').click(); }
function handlePhoto(e){
  const file=e.target.files[0]; if(!file) return;
  const reader=new FileReader();
  reader.onload=ev=>{
    const src=ev.target.result;
    document.getElementById('detail-photo').src=src;
    document.getElementById('detail-photo').style.display='block';
    document.getElementById('photo-placeholder').style.display='none';
    document.getElementById('photo-overlay-btn').style.display='flex';
    if(!diaries[currentUser][currentKey]) diaries[currentUser][currentKey]=blankEntry();
    diaries[currentUser][currentKey].photo=src;
  };
  reader.readAsDataURL(file); e.target.value='';
}
function toggleTag(el){ el.classList.toggle('selected'); }
function selectVis(el){
  currentVis=el.dataset.vis;
  document.querySelectorAll('#vis-row .vis-opt').forEach(o=>o.classList.toggle('selected',o===el));
}
function saveEntry(){
  if(!diaries[currentUser][currentKey]) diaries[currentUser][currentKey]=blankEntry();
  const e=diaries[currentUser][currentKey];
  e.menu=document.getElementById('menu-input').value;
  e.memo=document.getElementById('memo-box').value;
  e.tags=[...document.querySelectorAll('#tag-chips .tag-chip.selected')].map(c=>c.textContent);
  e.visibility=currentVis;
  closeDetail(); toast('저장했어요 ✨');
}

/* ===========================================================
   FEED (friends' visible meals)
   =========================================================== */
function visibleToMe(ownerId, entry){
  if(ownerId===currentUser) return true;
  if(entry.visibility==='private') return false;
  if(entry.visibility==='public') return true;
  // friends-only
  return friendships[currentUser] && friendships[currentUser].has(ownerId);
}

function collectFeed(){
  const items=[];
  Object.keys(diaries).forEach(ownerId=>{
    if(ownerId===currentUser) return;
    Object.keys(diaries[ownerId]).forEach(key=>{
      const entry=diaries[ownerId][key];
      if(!entry.menu) return;
      if(!visibleToMe(ownerId,entry)) return;
      const m=key.match(/^(\d{4}-\d{2}-\d{2})-(.+)$/);
      items.push({ ownerId, key, dateStr:m[1], meal:m[2], entry });
    });
  });
  items.sort((a,b)=> b.dateStr.localeCompare(a.dateStr));
  return items;
}

function renderFeed(){
  const wrap=document.getElementById('feed-list'); wrap.innerHTML='';
  const items=collectFeed();
  if(!items.length){
    wrap.innerHTML='<div class="empty-state">아직 친구들의 식단이 없어요.<br>친구를 추가하면 여기에 나타나요 🍽️</div>'; return;
  }
  items.forEach(it=>{
    const u=users[it.ownerId];
    const card=document.createElement('div'); card.className='feed-card';
    card.onclick=()=>openGuest(it.ownerId,it.key);
    const tagsHtml=(it.entry.tags||[]).map(t=>`<span class="pv-tag">${t}</span>`).join(' ');
    const thumbInner = it.entry.photo
      ? `<img src="${it.entry.photo}">`
      : `<span style="font-size:30px;">${mealEmoji(it.entry.menu)}</span>`;
    const md=it.dateStr.slice(5).replace('-','/');
    card.innerHTML=`
      <div class="feed-head">
        <span class="avatar" style="background:${AVATAR_COLORS[it.ownerId]}">${u.avatarText}</span>
        <span><span class="fh-name">${u.name}</span><br><span class="fh-meta">${md} · ${it.meal} · ${visLabel(it.entry.visibility)}</span></span>
      </div>
      <div class="feed-body">
        <div class="feed-thumb">${thumbInner}</div>
        <div class="feed-info"><div class="fi-menu">${it.entry.menu}</div><div class="fi-memo">${it.entry.memo||''}</div>
          <div class="pv-tags" style="margin-top:6px;">${tagsHtml}</div></div>
      </div>
      <div class="feed-foot">
        <span class="ff-item">💌 한마디 ${it.entry.notes.length}</span>
        <span class="ff-item" style="color:var(--accent);">✏️ 교환일기 남기기 →</span>
      </div>`;
    wrap.appendChild(card);
  });
}
function mealEmoji(menu){
  const map=[['면|국수|파스타|라면','🍜'],['밥|백반|덮밥','🍚'],['버거','🍔'],['포케|샐러드|요거트','🥗'],['떡볶이','🌶️'],['토스트|빵','🍞']];
  for(const [k,e] of map){ if(new RegExp(k).test(menu)) return e; } return '🍽️';
}
function visLabel(v){ return v==='public'?'전체공개':v==='friends'?'친구공개':'나만보기'; }

/* ===========================================================
   GUESTBOOK (exchange diary): view + leave note w/ drawing
   =========================================================== */
let guestOwner=null, guestKey=null;

function openGuest(ownerId,key){
  guestOwner=ownerId; guestKey=key;
  const entry=diaries[ownerId][key];
  const u=users[ownerId];
  const m=key.match(/^(\d{4}-\d{2}-\d{2})-(.+)$/);
  document.getElementById('guest-title').textContent=`${u.name}님의 식탁`;
  document.getElementById('guest-subtitle').textContent=`${m[1].slice(5).replace('-','/')} · ${m[2]}`;

  const thumb=document.getElementById('guest-thumb');
  thumb.innerHTML = entry.photo?`<img src="${entry.photo}">`:`<span style="font-size:32px;">${mealEmoji(entry.menu)}</span>`;
  document.getElementById('guest-menu').textContent=entry.menu;
  document.getElementById('guest-memo').textContent=entry.memo||'';
  document.getElementById('guest-tags').innerHTML=(entry.tags||[]).map(t=>`<span class="pv-tag">${t}</span>`).join(' ');

  renderNotes(entry);

  // composer only if not my own meal
  document.getElementById('composer').style.display = (ownerId===currentUser)?'none':'block';
  if(ownerId!==currentUser) setTimeout(initCanvas,50);

  document.getElementById('guest-view').style.display='block';
  document.getElementById('guest-view').scrollTop=0;
}
function closeGuest(){
  document.getElementById('guest-view').style.display='none';
  if(activeTab==='feed') renderFeed(); else renderGrid();
}
function renderNotes(entry){
  const list=document.getElementById('notes-list');
  document.getElementById('notes-count-label').textContent=`교환일기 (${entry.notes.length})`;
  if(!entry.notes.length){ list.innerHTML='<div class="notes-empty">아직 남겨진 한마디가 없어요. 첫 손그림을 남겨보세요 ✏️</div>'; return; }
  list.innerHTML='';
  entry.notes.slice().reverse().forEach(n=>{
    const item=document.createElement('div'); item.className='note-item';
    const drawHtml=n.draw?`<img class="note-draw" src="${n.draw}" style="width:100%;max-width:240px;">`:'';
    item.innerHTML=`
      <span class="avatar" style="background:${AVATAR_COLORS[n.by]||'#a89070'}">${(users[n.by]&&users[n.by].avatarText)||'?'}</span>
      <div class="note-body">
        <div class="note-head"><span class="nh-name">${n.byName}</span><span class="nh-time">${timeAgo(n.ts)}</span></div>
        ${n.text?`<div class="note-text">${escapeHtml(n.text)}</div>`:''}
        ${drawHtml}
      </div>`;
    list.appendChild(item);
  });
}

/* ---------- CANVAS DRAWING ---------- */
let ctx=null, drawing=false, penColor='#5a4e3c', tool='pen', hasDrawn=false, lastX=0, lastY=0;
function initCanvas(){
  const canvas=document.getElementById('note-canvas');
  const rect=canvas.getBoundingClientRect();
  const dpr=window.devicePixelRatio||1;
  canvas.width=rect.width*dpr; canvas.height=rect.height*dpr;
  ctx=canvas.getContext('2d'); ctx.scale(dpr,dpr);
  ctx.lineCap='round'; ctx.lineJoin='round';
  ctx.fillStyle='#fffdf6'; ctx.fillRect(0,0,rect.width,rect.height);
  hasDrawn=false; tool='pen'; penColor='#5a4e3c';
  document.querySelectorAll('.color-dot').forEach((d,i)=>d.classList.toggle('active',i===0));
  setTool('pen');

  const pos=e=>{
    const r=canvas.getBoundingClientRect();
    const t=e.touches?e.touches[0]:e;
    return { x:t.clientX-r.left, y:t.clientY-r.top };
  };
  const start=e=>{ e.preventDefault(); drawing=true; const p=pos(e); lastX=p.x; lastY=p.y; };
  const move=e=>{
    if(!drawing) return; e.preventDefault();
    const p=pos(e);
    ctx.strokeStyle = tool==='eraser'?'#fffdf6':penColor;
    ctx.lineWidth = tool==='eraser'?18:3;
    ctx.beginPath(); ctx.moveTo(lastX,lastY); ctx.lineTo(p.x,p.y); ctx.stroke();
    lastX=p.x; lastY=p.y; hasDrawn=true;
  };
  const end=()=>{ drawing=false; };
  canvas.onmousedown=start; canvas.onmousemove=move; window.onmouseup=end;
  canvas.ontouchstart=start; canvas.ontouchmove=move; canvas.ontouchend=end;
}
function pickColor(el){
  penColor=el.dataset.color; tool='pen';
  document.querySelectorAll('.color-dot').forEach(d=>d.classList.toggle('active',d===el));
  setTool('pen');
}
function setTool(t){
  tool=t;
  document.getElementById('pen-btn').classList.toggle('active',t==='pen');
  document.getElementById('eraser-btn').classList.toggle('active',t==='eraser');
}
function clearCanvas(){
  if(!ctx) return;
  const canvas=document.getElementById('note-canvas');
  const rect=canvas.getBoundingClientRect();
  ctx.fillStyle='#fffdf6'; ctx.fillRect(0,0,rect.width,rect.height); hasDrawn=false;
}
function leaveNote(){
  const text=document.getElementById('note-text').value.trim();
  if(!text && !hasDrawn){ toast('손그림이나 한마디를 남겨주세요'); return; }
  const entry=diaries[guestOwner][guestKey];
  const draw = hasDrawn?document.getElementById('note-canvas').toDataURL('image/png'):null;
  entry.notes.push({ by:currentUser, byName:users[currentUser].name, text, draw, ts:Date.now() });
  // notify the owner
  pushNotif(guestOwner, `<b>${users[currentUser].name}</b>님이 회원님의 <b>${entry.menu}</b> 식탁에 한마디를 남겼어요 💌`);
  document.getElementById('note-text').value=''; clearCanvas();
  renderNotes(entry);
  toast('교환일기를 남겼어요 💌'); updateBadges();
}

/* ===========================================================
   FRIENDS
   =========================================================== */
function renderFriends(){
  document.getElementById('search-result').innerHTML='';
  document.getElementById('friend-search').value='';
  // incoming requests
  const reqBlock=document.getElementById('requests-block');
  const incoming=friendRequests.filter(r=>r.to===currentUser);
  if(incoming.length){
    let html='<div class="list-section-label">받은 친구 요청</div>';
    incoming.forEach(r=>{
      const u=users[r.from];
      html+=`<div class="person-row">
        <span class="avatar" style="background:${AVATAR_COLORS[r.from]}">${u.avatarText}</span>
        <div class="pr-info"><div class="pr-name">${u.name}</div><div class="pr-code">${u.code}</div></div>
        <div class="req-btns">
          <button class="mini-btn" onclick="acceptReq('${r.from}')">수락</button>
          <button class="mini-btn ghost" onclick="rejectReq('${r.from}')">거절</button>
        </div></div>`;
    });
    reqBlock.innerHTML=html;
  } else reqBlock.innerHTML='';

  // friend list
  const list=document.getElementById('friends-list'); list.innerHTML='';
  const fset=friendships[currentUser];
  if(!fset || !fset.size){ list.innerHTML='<div class="empty-state" style="padding:24px;">아직 친구가 없어요.<br>위에서 코드로 친구를 찾아보세요!</div>'; return; }
  [...fset].forEach(fid=>{
    const u=users[fid];
    const row=document.createElement('div'); row.className='person-row';
    row.innerHTML=`<span class="avatar" style="background:${AVATAR_COLORS[fid]}">${u.avatarText}</span>
      <div class="pr-info"><div class="pr-name">${u.name}</div><div class="pr-code">${u.code}</div></div>
      <button class="mini-btn" onclick="switchTab('feed')">식단 보기</button>`;
    list.appendChild(row);
  });
}
function searchFriend(){
  const q=document.getElementById('friend-search').value.trim().toLowerCase();
  const box=document.getElementById('search-result'); box.innerHTML='';
  if(!q) return;
  const found=Object.values(users).filter(u=>
    u.id!==currentUser &&
    (u.code.toLowerCase().includes(q)||u.name.toLowerCase().includes(q)));
  if(!found.length){ box.innerHTML='<div class="empty-state" style="padding:20px;">검색 결과가 없어요 🔍</div>'; return; }
  found.forEach(u=>{
    const isFriend=friendships[currentUser].has(u.id);
    const pendingOut=friendRequests.some(r=>r.from===currentUser&&r.to===u.id);
    const pendingIn=friendRequests.some(r=>r.from===u.id&&r.to===currentUser);
    let btn;
    if(isFriend) btn=`<button class="mini-btn pending">친구✓</button>`;
    else if(pendingOut) btn=`<button class="mini-btn pending">요청됨</button>`;
    else if(pendingIn) btn=`<button class="mini-btn" onclick="acceptReq('${u.id}')">수락하기</button>`;
    else btn=`<button class="mini-btn" onclick="sendReq('${u.id}')">+ 친구 요청</button>`;
    const row=document.createElement('div'); row.className='person-row';
    row.innerHTML=`<span class="avatar" style="background:${AVATAR_COLORS[u.id]}">${u.avatarText}</span>
      <div class="pr-info"><div class="pr-name">${u.name}</div><div class="pr-code">${u.code}</div></div>${btn}`;
    box.appendChild(row);
  });
}
function sendReq(toId){
  friendRequests.push({ from:currentUser, to:toId });
  pushNotif(toId, `<b>${users[currentUser].name}</b>님이 친구 요청을 보냈어요 👋`);
  toast(`${users[toId].name}님에게 요청을 보냈어요`);
  searchFriend(); updateBadges();
}
function acceptReq(fromId){
  friendRequests=friendRequests.filter(r=>!(r.from===fromId&&r.to===currentUser));
  friendships[currentUser].add(fromId);
  friendships[fromId].add(currentUser);
  pushNotif(fromId, `<b>${users[currentUser].name}</b>님이 친구 요청을 수락했어요 🎉`);
  toast(`${users[fromId].name}님과 친구가 되었어요 🎉`);
  renderFriends(); updateBadges();
}
function rejectReq(fromId){
  friendRequests=friendRequests.filter(r=>!(r.from===fromId&&r.to===currentUser));
  renderFriends(); updateBadges();
}

/* ===========================================================
   NOTIFICATIONS
   =========================================================== */
function renderNotifs(){
  const list=document.getElementById('notif-list'); list.innerHTML='';
  const arr=notifs[currentUser];
  if(!arr.length){ list.innerHTML='<div class="empty-state">알림이 없어요 🔔</div>'; return; }
  arr.forEach(n=>{
    const item=document.createElement('div');
    item.className='notif-item'+(n.read?'':' unread');
    item.innerHTML=`${n.read?'':'<span class="notif-unread-dot"></span>'}
      <div class="ni-text">${n.text}</div><div class="ni-time">${timeAgo(n.ts)}</div>`;
    list.appendChild(item);
  });
}
function markAllNotifsRead(){
  setTimeout(()=>{ notifs[currentUser].forEach(n=>n.read=true); updateBadges(); }, 800);
}

/* ===========================================================
   UTILITIES
   =========================================================== */
function timeAgo(ts){
  const s=Math.floor((Date.now()-ts)/1000);
  if(s<60) return '방금';
  if(s<3600) return Math.floor(s/60)+'분 전';
  if(s<86400) return Math.floor(s/3600)+'시간 전';
  return Math.floor(s/86400)+'일 전';
}
function escapeHtml(str){ const d=document.createElement('div'); d.textContent=str; return d.innerHTML; }
let toastTimer=null;
function toast(msg){
  const t=document.getElementById('toast'); t.textContent=msg; t.classList.add('show');
  clearTimeout(toastTimer); toastTimer=setTimeout(()=>t.classList.remove('show'),1800);
}
function openMagazine(){ document.getElementById('magazine-modal').style.display='block'; document.body.style.overflow='hidden'; }
function closeMagazine(){ document.getElementById('magazine-modal').style.display='none'; document.body.style.overflow='auto'; }
window.addEventListener('click', e=>{ if(e.target===document.getElementById('magazine-modal')) closeMagazine(); });

