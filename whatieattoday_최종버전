<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>whatieattoday — social</title>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --ivory: #f0ece0;
      --shadow-out: 6px 6px 14px #c8c4b8, -6px -6px 14px #ffffff;
      --shadow-in: inset 4px 4px 10px #c8c4b8, inset -4px -4px 10px #ffffff;
      --shadow-sm: 3px 3px 8px #c8c4b8, -3px -3px 8px #ffffff;
      --accent: #a89070;
      --accent-deep: #8b6f4e;
      --text-main: #5a4e3c;
      --text-muted: #9a8e7c;
      --text-light: #bbb0a0;
    }
    body { background: var(--ivory); font-family: 'Caveat', cursive; color: var(--text-main); min-height: 100vh; }
    #app { min-height: 100vh; background: var(--ivory); max-width: 480px; margin: 0 auto; position: relative; padding-bottom: 76px; }

    /* ===== TOP BAR (account switcher) ===== */
    .top-bar {
      display: flex; align-items: center; justify-content: space-between;
      padding: 14px 16px 6px;
    }
    .me-chip {
      display: flex; align-items: center; gap: 8px;
      background: var(--ivory); box-shadow: var(--shadow-sm);
      border: none; border-radius: 20px; padding: 5px 12px 5px 5px;
      cursor: pointer; font-family: 'Caveat', cursive; transition: box-shadow .15s;
    }
    .me-chip:active { box-shadow: var(--shadow-in); }
    .avatar {
      width: 30px; height: 30px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 17px; color: #fff; flex-shrink: 0; font-family: sans-serif;
    }
    .me-chip .me-name { font-size: 17px; color: var(--text-main); }
    .me-chip .me-code { font-size: 12px; color: var(--text-muted); }
    .icon-btn {
      width: 38px; height: 38px; border-radius: 50%; border: none;
      background: var(--ivory); box-shadow: var(--shadow-sm); cursor: pointer;
      font-size: 18px; color: var(--text-muted); position: relative;
      display: flex; align-items: center; justify-content: center; transition: box-shadow .15s;
    }
    .icon-btn:active { box-shadow: var(--shadow-in); }
    .badge {
      position: absolute; top: -2px; right: -2px; min-width: 17px; height: 17px;
      background: #c4756a; color: #fff; border-radius: 9px; font-size: 11px;
      font-family: sans-serif; display: flex; align-items: center; justify-content: center;
      padding: 0 4px; border: 2px solid var(--ivory);
    }

    /* ===== MAIN VIEW ===== */
    #main-view { padding: 4px 16px 32px; }
    .app-header { text-align: center; padding: 8px 0 18px; }
    .app-header h1 {
      font-size: 30px; font-weight: 700; color: var(--text-main);
      letter-spacing: 1px; transform: rotate(-1.5deg); display: inline-block; margin-bottom: 4px;
    }
    .app-header p { font-size: 16px; color: var(--text-muted); transform: rotate(0.8deg); display: inline-block; }

    .week-nav { display: flex; align-items: center; justify-content: center; gap: 16px; margin-bottom: 18px; }
    .nav-btn {
      width: 36px; height: 36px; border-radius: 50%; border: none;
      background: var(--ivory); box-shadow: var(--shadow-sm);
      cursor: pointer; font-size: 18px; color: var(--text-muted);
      display: flex; align-items: center; justify-content: center; transition: box-shadow .15s;
    }
    .nav-btn:active { box-shadow: var(--shadow-in); }
    .week-label { font-size: 16px; color: var(--text-muted); min-width: 130px; text-align: center; }

    .days-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; margin-bottom: 16px; }
    .day-col { display: flex; flex-direction: column; gap: 6px; align-items: center; }
    .day-label { font-size: 14px; color: var(--text-muted); padding: 4px 0 2px; text-align: center; }
    .day-label.today { color: var(--accent); font-weight: 700; }

    .meal-thumb {
      width: 100%; aspect-ratio: 1; border-radius: 14px;
      background: var(--ivory); box-shadow: var(--shadow-sm);
      cursor: pointer; overflow: hidden; position: relative;
      transition: box-shadow .15s, transform .15s; border: none; display: block;
    }
    .meal-thumb:active { box-shadow: var(--shadow-in); transform: scale(0.97); }
    .meal-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 14px; display: block; }
    .default-icon { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
    .meal-time-label {
      position: absolute; bottom: 3px; left: 0; right: 0;
      text-align: center; font-size: 9px; color: var(--text-muted);
    }
    .meal-thumb.has-photo .meal-time-label, .meal-thumb.has-draw .meal-time-label {
      color: rgba(255,255,255,0.92); text-shadow: 0 1px 3px rgba(0,0,0,0.35);
    }
    /* dot marker: friends left notes on my meal */
    .friend-dot {
      position: absolute; top: 5px; right: 5px; width: 9px; height: 9px;
      border-radius: 50%; background: #c4756a; border: 1.5px solid var(--ivory);
    }

    /* ===== BOTTOM NAV ===== */
    .bottom-nav {
      position: fixed; bottom: 0; left: 50%; transform: translateX(-50%);
      width: 100%; max-width: 480px; display: flex; justify-content: space-around;
      background: var(--ivory); padding: 8px 0 12px; box-shadow: 0 -4px 14px rgba(200,196,184,0.5);
      z-index: 50;
    }
    .tab-btn {
      background: none; border: none; cursor: pointer; font-family: 'Caveat', cursive;
      font-size: 13px; color: var(--text-light); display: flex; flex-direction: column;
      align-items: center; gap: 2px; padding: 4px 16px; border-radius: 14px; position: relative;
    }
    .tab-btn .tab-ico { font-size: 20px; }
    .tab-btn.active { color: var(--accent); }
    .tab-btn .badge { top: 0; right: 8px; }

    /* ===== MAGAZINE ===== */
    .magazine-section { margin-top: 22px; padding: 0 4px; }
    .magazine-banner {
      background: var(--ivory); box-shadow: var(--shadow-out); border-radius: 20px;
      padding: 16px; cursor: pointer; display: flex; align-items: center; gap: 14px; transition: transform .2s;
    }
    .magazine-banner:active { transform: scale(0.98); box-shadow: var(--shadow-in); }
    .magazine-icon { font-size: 24px; }
    .magazine-info h3 { font-size: 19px; color: var(--accent); }
    .magazine-info p { font-size: 14px; color: var(--text-muted); }

    /* ===== SHARED MODAL / FULL VIEW ===== */
    .full-view {
      display: none; position: fixed; inset: 0; background: var(--ivory);
      z-index: 100; overflow-y: auto; padding: 0 0 90px; max-width: 480px; margin: 0 auto;
    }
    .full-header {
      display: flex; align-items: center; padding: 16px 16px 12px; gap: 12px;
      position: sticky; top: 0; background: var(--ivory); z-index: 10;
    }
    .back-btn {
      width: 40px; height: 40px; border-radius: 50%; border: none;
      background: var(--ivory); box-shadow: var(--shadow-sm); cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      font-size: 20px; color: var(--text-muted); flex-shrink: 0; transition: box-shadow .15s;
    }
    .back-btn:active { box-shadow: var(--shadow-in); }
    .full-title { font-size: 22px; color: var(--text-main); }
    .full-subtitle { font-size: 14px; color: var(--text-muted); margin-top: 1px; }
    .section-label { font-size: 15px; color: var(--text-muted); margin-bottom: 8px; }

    /* ===== DETAIL (my meal edit) ===== */
    .photo-upload-area {
      margin: 8px 16px 0; border-radius: 24px; background: var(--ivory);
      box-shadow: var(--shadow-out); aspect-ratio: 4/3;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; overflow: hidden; position: relative; transition: box-shadow .15s;
    }
    .photo-upload-area img { width: 100%; height: 100%; object-fit: cover; border-radius: 24px; }
    .photo-placeholder { display: flex; flex-direction: column; align-items: center; gap: 10px; }
    .photo-placeholder p { font-size: 15px; color: var(--text-light); }
    .photo-overlay-btn {
      position: absolute; bottom: 14px; right: 14px; background: var(--ivory);
      box-shadow: var(--shadow-sm); border: none; border-radius: 50%; width: 38px; height: 38px;
      display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--accent); font-size: 20px;
    }
    #photo-input { display: none; }
    .menu-input-wrap { padding: 16px 16px 0; }
    .menu-row {
      background: var(--ivory); box-shadow: var(--shadow-in); border: none;
      border-radius: 16px; padding: 10px 14px; width: 100%; display: flex; align-items: center; gap: 8px;
    }
    .menu-row input {
      background: transparent; border: none; outline: none; flex: 1;
      font-family: 'Caveat', cursive; font-size: 17px; color: var(--text-main);
    }
    .menu-row input::placeholder { color: var(--text-light); }
    .memo-section { padding: 14px 16px 0; }
    .memo-box {
      background: var(--ivory); box-shadow: var(--shadow-in); border: none;
      border-radius: 18px; padding: 12px 16px; width: 100%; min-height: 70px;
      font-family: 'Caveat', cursive; font-size: 17px; color: var(--text-main);
      resize: none; outline: none; line-height: 1.6;
    }
    .memo-box::placeholder { color: var(--text-light); }
    .tags-section { padding: 14px 16px 0; }
    .tag-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
    .tag-chip {
      padding: 5px 14px; border-radius: 20px; background: var(--ivory);
      box-shadow: var(--shadow-sm); font-family: 'Caveat', cursive; font-size: 15px;
      color: var(--text-muted); cursor: pointer; border: none; transition: box-shadow .15s;
    }
    .tag-chip.selected { box-shadow: var(--shadow-in); color: var(--accent); }

    /* visibility selector */
    .vis-section { padding: 14px 16px 0; }
    .vis-row { display: flex; gap: 8px; margin-top: 8px; }
    .vis-opt {
      flex: 1; padding: 8px 4px; border-radius: 16px; background: var(--ivory);
      box-shadow: var(--shadow-sm); font-family: 'Caveat', cursive; font-size: 14px;
      color: var(--text-muted); cursor: pointer; border: none; text-align: center; transition: box-shadow .15s;
    }
    .vis-opt.selected { box-shadow: var(--shadow-in); color: var(--accent); font-weight: 700; }

    .save-btn {
      margin: 22px 16px 0; width: calc(100% - 32px); padding: 14px;
      border-radius: 20px; border: none; background: var(--ivory);
      box-shadow: var(--shadow-out); font-family: 'Caveat', cursive;
      font-size: 20px; color: var(--accent); letter-spacing: 2px; cursor: pointer; transition: box-shadow .15s;
    }
    .save-btn:active { box-shadow: var(--shadow-in); }

    /* ===== EXCHANGE-DIARY GUESTBOOK (notes on a meal) ===== */
    .meal-preview-card {
      margin: 8px 16px 0; border-radius: 24px; background: var(--ivory);
      box-shadow: var(--shadow-out); padding: 18px; display: flex; gap: 14px; align-items: center;
    }
    .meal-preview-thumb {
      width: 84px; height: 84px; border-radius: 18px; flex-shrink: 0; overflow: hidden;
      box-shadow: var(--shadow-in); display: flex; align-items: center; justify-content: center;
      background: linear-gradient(135deg,#fdf6e8,#f5edd8);
    }
    .meal-preview-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .meal-preview-info .pv-menu { font-size: 21px; color: var(--text-main); }
    .meal-preview-info .pv-memo { font-size: 15px; color: var(--text-muted); margin-top: 2px; line-height: 1.4; }
    .meal-preview-info .pv-tags { margin-top: 6px; display: flex; flex-wrap: wrap; gap: 5px; }
    .pv-tag { font-size: 12px; color: #fff; background: var(--accent); padding: 1px 9px; border-radius: 10px; }

    .notes-wrap { padding: 18px 16px 0; }
    .note-item {
      background: var(--ivory); box-shadow: var(--shadow-sm); border-radius: 18px;
      padding: 12px 14px; margin-bottom: 12px; display: flex; gap: 10px;
    }
    .note-item .note-body { flex: 1; }
    .note-head { display: flex; align-items: center; gap: 7px; margin-bottom: 4px; }
    .note-head .nh-name { font-size: 16px; color: var(--text-main); font-weight: 600; }
    .note-head .nh-time { font-size: 12px; color: var(--text-light); }
    .note-text { font-size: 16px; color: var(--text-main); line-height: 1.45; }
    .note-draw { margin-top: 8px; border-radius: 14px; box-shadow: var(--shadow-in); background:#fffdf6; display: block; }
    .notes-empty { text-align: center; color: var(--text-light); font-size: 16px; padding: 18px 0 4px; }

    /* leave-a-note composer */
    .composer {
      margin: 6px 16px 0; background: var(--ivory); box-shadow: var(--shadow-out);
      border-radius: 22px; padding: 16px;
    }
    .composer .section-label { margin-bottom: 10px; }
    .draw-tools { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; }
    .color-dot {
      width: 26px; height: 26px; border-radius: 50%; cursor: pointer; border: none;
      box-shadow: var(--shadow-sm); transition: transform .12s;
    }
    .color-dot.active { transform: scale(1.18); box-shadow: var(--shadow-in); }
    .tool-btn {
      background: var(--ivory); box-shadow: var(--shadow-sm); border: none; border-radius: 12px;
      padding: 5px 11px; cursor: pointer; font-family: 'Caveat', cursive; font-size: 14px; color: var(--text-muted);
    }
    .tool-btn.active { box-shadow: var(--shadow-in); color: var(--accent); }
    #note-canvas {
      width: 100%; height: 180px; border-radius: 16px; background: #fffdf6;
      box-shadow: var(--shadow-in); touch-action: none; display: block; cursor: crosshair;
    }
    .note-text-input {
      margin-top: 10px; background: var(--ivory); box-shadow: var(--shadow-in); border: none;
      border-radius: 14px; padding: 10px 14px; width: 100%; min-height: 50px;
      font-family: 'Caveat', cursive; font-size: 17px; color: var(--text-main); resize: none; outline: none;
    }
    .note-text-input::placeholder { color: var(--text-light); }
    .leave-btn {
      margin-top: 12px; width: 100%; padding: 12px; border-radius: 18px; border: none;
      background: var(--ivory); box-shadow: var(--shadow-out); font-family: 'Caveat', cursive;
      font-size: 19px; color: var(--accent); letter-spacing: 1px; cursor: pointer; transition: box-shadow .15s;
    }
    .leave-btn:active { box-shadow: var(--shadow-in); }

    /* ===== FRIENDS VIEW ===== */
    .friends-search-row { padding: 8px 16px 0; display: flex; gap: 8px; }
    .friends-search-row input {
      flex: 1; background: var(--ivory); box-shadow: var(--shadow-in); border: none;
      border-radius: 16px; padding: 10px 14px; font-family: 'Caveat', cursive; font-size: 17px;
      color: var(--text-main); outline: none;
    }
    .friends-search-row input::placeholder { color: var(--text-light); }
    .small-btn {
      background: var(--ivory); box-shadow: var(--shadow-sm); border: none; border-radius: 16px;
      padding: 0 16px; cursor: pointer; font-family: 'Caveat', cursive; font-size: 16px;
      color: var(--accent); transition: box-shadow .15s;
    }
    .small-btn:active { box-shadow: var(--shadow-in); }
    .list-section-label { padding: 18px 18px 6px; font-size: 16px; color: var(--text-muted); }
    .person-row {
      margin: 0 16px 10px; background: var(--ivory); box-shadow: var(--shadow-sm); border-radius: 18px;
      padding: 11px 14px; display: flex; align-items: center; gap: 11px;
    }
    .person-row .pr-info { flex: 1; }
    .person-row .pr-name { font-size: 17px; color: var(--text-main); }
    .person-row .pr-code { font-size: 12px; color: var(--text-muted); }
    .req-btns { display: flex; gap: 6px; }
    .mini-btn {
      border: none; border-radius: 12px; padding: 6px 12px; cursor: pointer;
      font-family: 'Caveat', cursive; font-size: 15px; background: var(--ivory);
      box-shadow: var(--shadow-sm); color: var(--accent); transition: box-shadow .15s;
    }
    .mini-btn:active { box-shadow: var(--shadow-in); }
    .mini-btn.ghost { color: var(--text-light); }
    .mini-btn.pending { color: var(--text-light); box-shadow: var(--shadow-in); cursor: default; }

    /* ===== FEED VIEW ===== */
    .feed-card {
      margin: 0 16px 16px; background: var(--ivory); box-shadow: var(--shadow-out);
      border-radius: 24px; padding: 16px; cursor: pointer; transition: transform .15s, box-shadow .15s;
    }
    .feed-card:active { transform: scale(0.99); box-shadow: var(--shadow-in); }
    .feed-head { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
    .feed-head .fh-name { font-size: 17px; color: var(--text-main); }
    .feed-head .fh-meta { font-size: 13px; color: var(--text-muted); }
    .feed-body { display: flex; gap: 14px; }
    .feed-thumb {
      width: 92px; height: 92px; border-radius: 18px; flex-shrink: 0; overflow: hidden;
      box-shadow: var(--shadow-in); display: flex; align-items: center; justify-content: center;
      background: linear-gradient(135deg,#fdf6e8,#f5edd8);
    }
    .feed-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .feed-info .fi-menu { font-size: 21px; color: var(--text-main); }
    .feed-info .fi-memo { font-size: 15px; color: var(--text-muted); margin-top: 2px; line-height: 1.4; }
    .feed-foot { margin-top: 11px; display: flex; align-items: center; gap: 14px; font-size: 14px; color: var(--text-muted); }
    .feed-foot .ff-item { display: flex; align-items: center; gap: 4px; }

    /* ===== NOTIFICATIONS ===== */
    .notif-item {
      margin: 0 16px 10px; background: var(--ivory); box-shadow: var(--shadow-sm); border-radius: 18px;
      padding: 12px 14px; display: flex; align-items: center; gap: 11px; cursor: pointer;
    }
    .notif-item.unread { box-shadow: var(--shadow-out); }
    .notif-item .ni-text { flex: 1; font-size: 16px; color: var(--text-main); line-height: 1.35; }
    .notif-item .ni-text b { font-weight: 700; }
    .notif-item .ni-time { font-size: 12px; color: var(--text-light); }
    .notif-unread-dot { width: 8px; height: 8px; border-radius: 50%; background: #c4756a; flex-shrink: 0; }

    /* ===== MAGAZINE MODAL ===== */
    #magazine-modal { display: none; position: fixed; inset: 0; background: var(--ivory); z-index: 200; padding: 30px 20px; overflow-y: auto; }
    .modal-content { max-width: 450px; margin: 0 auto; position: relative; }
    .modal-close { position: absolute; top: -10px; right: 0; background: none; border: none; font-size: 32px; color: var(--text-muted); cursor: pointer; font-family: sans-serif; }
    .mag-item { background: var(--ivory); box-shadow: var(--shadow-sm); border-radius: 24px; padding: 22px; margin-bottom: 20px; line-height: 1.6; }
    .mag-item h4 { font-size: 22px; color: var(--accent); margin-bottom: 8px; }
    .mag-item p { font-size: 16px; color: var(--text-main); }
    .mag-tag { display: inline-block; font-size: 13px; color: #fff; background: var(--accent); padding: 2px 10px; border-radius: 12px; margin-bottom: 10px; }

    /* account switcher sheet */
    #acct-sheet { display: none; position: fixed; inset: 0; background: rgba(90,78,60,0.25); z-index: 300; }
    .sheet-panel {
      position: absolute; bottom: 0; left: 50%; transform: translateX(-50%);
      width: 100%; max-width: 480px; background: var(--ivory); border-radius: 26px 26px 0 0;
      padding: 22px 18px 30px; box-shadow: 0 -6px 20px rgba(0,0,0,0.12);
    }
    .sheet-title { text-align: center; font-size: 20px; color: var(--text-main); margin-bottom: 6px; }
    .sheet-sub { text-align: center; font-size: 14px; color: var(--text-muted); margin-bottom: 16px; }
    .acct-opt {
      display: flex; align-items: center; gap: 12px; padding: 11px 14px; margin-bottom: 10px;
      border-radius: 18px; background: var(--ivory); box-shadow: var(--shadow-sm); cursor: pointer; border: none; width: 100%;
    }
    .acct-opt.current { box-shadow: var(--shadow-in); }
    .acct-opt .ao-name { font-family: 'Caveat', cursive; font-size: 18px; color: var(--text-main); }
    .acct-opt .ao-code { font-family: 'Caveat', cursive; font-size: 12px; color: var(--text-muted); }

    .empty-state { text-align: center; color: var(--text-light); font-size: 17px; padding: 50px 30px; line-height: 1.5; }
    .toast {
      position: fixed; bottom: 90px; left: 50%; transform: translateX(-50%);
      background: var(--accent-deep); color: #fff; padding: 10px 20px; border-radius: 18px;
      font-family: 'Caveat', cursive; font-size: 16px; z-index: 400; opacity: 0;
      transition: opacity .25s; pointer-events: none; white-space: nowrap;
    }
    .toast.show { opacity: 0.96; }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>
</head>
<body>
<div id="app">

  <!-- ===== TOP BAR ===== -->
  <div class="top-bar">
    <button class="me-chip" onclick="openAcctSheet()">
      <span class="avatar" id="me-avatar"></span>
      <span>
        <span class="me-name" id="me-name"></span><br>
        <span class="me-code" id="me-code"></span>
      </span>
    </button>
    <button class="icon-btn" onclick="switchTab('notif')">
      🔔<span class="badge" id="notif-badge" style="display:none;">0</span>
    </button>
  </div>

  <!-- ===== HOME TAB ===== -->
  <div id="tab-home">
    <div id="main-view">
      <div class="app-header">
        <h1>whatieattoday</h1><br>
        <p>오늘의 식사는 어떠셨나요?</p>
      </div>
      <div class="week-nav">
        <button class="nav-btn" onclick="changeWeek(-1)">&#8249;</button>
        <span class="week-label" id="week-label"></span>
        <button class="nav-btn" onclick="changeWeek(1)">&#8250;</button>
      </div>
      <div class="days-grid" id="days-grid"></div>
      <div class="magazine-section">
        <div class="magazine-banner" onclick="openMagazine()">
          <div class="magazine-icon">🍴</div>
          <div class="magazine-info">
